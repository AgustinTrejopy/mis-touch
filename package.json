{
  "name": "mis-touch",
  "private": true,
  "version": "0.1.0",
  "description": "PWA liviana y offline para llevar el registro de tu colección de marcadores ShinHan TOUCH Twin.",
  "license": "MIT",
  "keywords": [
    "pwa",
    "offline",
    "markers",
    "touch-twin",
    "shinhan",
    "color-swatches",
    "vite",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "catalog": "node scripts/build-catalog.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
